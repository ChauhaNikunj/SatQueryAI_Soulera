# SatQuery AI — environment variable overrides
# Copy to .env and fill in real paths before running.

# Path to RemoteCLIP ViT-B/32 checkpoint
# Download: https://github.com/ChenDelong1999/RemoteCLIP/releases/download/v1.0/RemoteCLIP-ViT-B-32.pt
REMOTECLIP_WEIGHTS=./weights/RemoteCLIP-ViT-B-32.pt

# Path to trained fusion adapter checkpoint (leave blank until trained)
ADAPTER_WEIGHTS=

# Directory where execution_trace.jsonl will be written
SATQUERY_LOG_DIR=./logs

# Enable cross-attention gate in the fusion model (true | false)
USE_CROSS_ATTN=false

# Maximum allowed upload size in MB
MAX_UPLOAD_MB=200
